{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "( git status --porcelain -- app/src/test/kotlin app/src/androidTest/kotlin | grep -q . && python3 scripts/gen-test-registry.py ) 2>/dev/null; true",
            "statusMessage": "Regenerating test registry..."
          }
        ]
      }
    ]
  }
}
