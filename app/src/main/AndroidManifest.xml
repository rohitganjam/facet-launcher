<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Phase 7 Launcher Hub (F5) — without this, AppWidgetManager.getInstalledProviders()
             comes back incomplete/empty on API 30+'s package-visibility filtering, since a widget
             provider's own package is otherwise invisible to us without a matching <queries> entry. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <!-- F2 Recents/Most Used — special-access permission, granted via system Settings (ACTION_USAGE_ACCESS_SETTINGS),
         never through a normal runtime dialog. Declaring it is still required for AppOpsManager's check to resolve. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- F1 Calendar integration — normal runtime permission, requested from CalendarSettingsScreen's "Turn on" action. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- F6 Contacts search — normal runtime permission, requested when Settings' "Search contacts" row is turned on. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Home swipe-down → notification shade — normal-level permission (auto-granted, no runtime prompt), required for StatusBarManager.expandNotificationsPanel(). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- App context menu's Uninstall action (AppContextMenu.kt, ACTION_DELETE) — normal-level permission
         (auto-granted, no runtime prompt). Without it, at least on this Samsung/One UI build, the
         system's UninstallLaunch confirmation activity logs "does not have REQUEST_DELETE_PACKAGES or
         DELETE_PACKAGES" and finishes itself before ever showing the dialog, so the uninstall trigger
         silently does nothing. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Private Space (Android 15+) — required for LauncherApps.getLauncherUserInfo to positively
         identify a Private Space handle (USER_TYPE_PROFILE_PRIVATE) rather than silently falling
         back to PERSONAL; see AppRepository.profileFor's doc. Per Android's own launcher-integration
         docs, this also requires holding RoleManager.ROLE_HOME, which this app already holds once
         set as the default launcher (see DefaultLauncherRepository) — no separate role request. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <application
        android:name=".FacetApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FacetLauncher"
        android:supportsRtl="true">

        <!-- Lets the :benchmark module's MacrobenchmarkRule trace this app's `benchmark` build
             type without a full release signature — see benchmark/build.gradle.kts. -->
        <profileable android:shell="true" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.FacetLauncher"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Facet deep links (`facetlauncher://facet/{id}`) — lets an external app or
                 automation tool switch the active facet without going through our own dynamic
                 shortcuts (data/FacetShortcutRepository.kt). A separate filter, not folded into the
                 HOME one above, since a custom-scheme ACTION_VIEW link and the HOME category are
                 unrelated match conditions. See domain/ActivateFacetByIdUseCase.kt. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="facetlauncher"
                    android:host="facet" />
            </intent-filter>
        </activity>

        <!-- F13 Notification badges — special-access permission, granted per-app via system
             Settings (ACTION_NOTIFICATION_LISTENER_SETTINGS), never a runtime dialog. The
             android:permission attribute (not a <uses-permission>) is what restricts binding to
             the system itself — see NotificationAccessRepository for the grant check. -->
        <service
            android:name=".data.FacetNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
