<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background rounded square (fills the full canvas; safe-zone scaling only applies to foreground content) -->
    <path android:pathData="M24,0 H84 A24,24 0 0,1 108,24 V84 A24,24 0 0,1 84,108 H24 A24,24 0 0,1 0,84 V24 A24,24 0 0,1 24,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="0"
                android:centerY="33.75"
                android:gradientRadius="67.5">
                <item android:offset="0" android:color="#141226" />
                <item android:offset="1" android:color="#080812" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer L stroke (scaled 0.65x about the canvas center, by farthest-corner distance rather than
         axis-aligned margin, since a circular icon mask clips by radius from center, not by a square) -->
    <path
        android:pathData="M36.45,31.25 V71.55 H76.75"
        android:fillColor="#00000000"
        android:strokeWidth="5.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="36.45"
                android:startY="51.4"
                android:endX="76.75"
                android:endY="51.4">
                <item android:offset="0" android:color="#D9AD40" />
                <item android:offset="0.35" android:color="#FFE073" />
                <item android:offset="0.65" android:color="#FFEB8C" />
                <item android:offset="1" android:color="#D19E33" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner L stroke -->
    <path
        android:pathData="M44.9,39.7 V63.1 H68.3"
        android:fillColor="#00000000"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="44.9"
                android:startY="51.4"
                android:endX="68.3"
                android:endY="51.4">
                <item android:offset="0" android:color="#D9AD40" />
                <item android:offset="0.35" android:color="#FFE073" />
                <item android:offset="0.65" android:color="#FFEB8C" />
                <item android:offset="1" android:color="#D19E33" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft glow circle -->
    <path android:pathData="M57.9,63.1 A13,13 0 1,1 31.9,63.1 A13,13 0 1,1 57.9,63.1 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="44.9"
                android:centerY="63.1"
                android:gradientRadius="13">
                <item android:offset="0" android:color="#E6FFF7D9" />
                <item android:offset="0.3" android:color="#66FFE68C" />
                <item android:offset="0.7" android:color="#1AFFD966" />
                <item android:offset="1" android:color="#00FFCC4D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bright core dot -->
    <path android:pathData="M48.8,63.43 A4.23,4.23 0 1,1 40.35,63.43 A4.23,4.23 0 1,1 48.8,63.43 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="44.58"
                android:centerY="63.43"
                android:gradientRadius="4.23">
                <item android:offset="0" android:color="#FFFFFF" />
                <item android:offset="0.5" android:color="#99FFF2BF" />
                <item android:offset="1" android:color="#00FFE680" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
